{
  "id": "soundbrenner_sync",
  "name": "Soundbrenner Sync",
  "version": "0.1.28",
  "private": false,
  "standards": ["capability-pipelines.v1", "plugin-runtime-idempotent.v1"],
  "nav": { "label": "Soundbrenner", "screen": "soundbrenner-sync" },
  "screen": "screen.html",
  "script": "screen.js",
  "settings": { "html": "settings.html" },
  "routes": "routes.py",
  "capabilities": {
    "playback": {
      "roles": ["observer"],
      "kind": "event",
      "observes": ["loading", "ready", "started", "resumed", "paused", "stopped", "ended", "seeked"],
      "description": "Observes playback lifecycle events to start, realign, and stop Soundbrenner haptic sync while retaining legacy song-event fallbacks.",
      "mode": "active",
      "compatibility": "shim-allowed",
      "ownership": "observer-only",
      "safety": "safe",
      "version": 1
    }
  },
  "runtime_domains": {
    "tempo-clock": {
      "roles": ["provider"],
      "events": ["midi-clock", "transport.start", "transport.stop"],
      "description": "Provides a hardware-backed haptic tempo clock once the future tempo-clock domain is promoted.",
      "mode": "optional",
      "compatibility": "degrade-noop",
      "ownership": "multi-provider",
      "safety": "safe"
    }
  }
}
